            raise RuntimeError(f"Failed to compile '{file_name}': {compile_res.stderr}")
        
        runner_path = self.source_dir / "JavaRunner.java"
        if not runner_path.exists():
            runner_code = (
                "import java.lang.reflect.Method;\n\n"
                "public class JavaRunner {\n"
                "    public static void main(String[] args) throws Exception {\n"
                "        if (args.length < 2) {\n"
