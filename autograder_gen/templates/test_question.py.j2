                "            System.exit(1);\n"
                "        }\n"
                "        String className = args[0];\n"
                "        String methodName = args[1];\n"
                "        Class<?> clazz = Class.forName(className);\n"
                "        Method targetMethod = null;\n"
                "        for (Method m : clazz.getDeclaredMethods()) {\n"
                "            if (m.getName().equals(methodName)) {\n"
                "                targetMethod = m;\n"
                "                break;\n"
                "            }\n"
                "        }\n"
                "        if (targetMethod == null) {\n"
                "            System.err.println(\"Method \" + methodName + \" not found in \" + className);\n"
                "            System.exit(1);\n"
                "        }\n"
                "        Object[] methodArgs = new Object[args.length - 2];\n"
                "        for (int i = 2; i < args.length; i++) {\n"
                "            methodArgs[i - 2] = args[i];\n"
                "        }\n"
                "        Object instance = null;\n"
                "        if (!java.lang.reflect.Modifier.isStatic(targetMethod.getModifiers())) {\n"
                "            instance = clazz.getDeclaredConstructor().newInstance();\n"
                "        }\n"
                "        Object result = null;\n"
                "        if (targetMethod.getParameterCount() == 1 && targetMethod.getParameterTypes()[0].isArray()) {\n"
                "            result = targetMethod.invoke(instance, (Object) methodArgs);\n"
                "        } else if (targetMethod.getParameterCount() == methodArgs.length) {\n"
                "            Class<?>[] paramTypes = targetMethod.getParameterTypes();\n"
                "            Object[] convertedArgs = new Object[methodArgs.length];\n"
                "            for (int i = 0; i < methodArgs.length; i++) {\n"
                "                convertedArgs[i] = convertArg(methodArgs[i].toString(), paramTypes[i]);\n"
                "            }\n"
                "            result = targetMethod.invoke(instance, convertedArgs);\n"
                "        } else {\n"
                "            result = targetMethod.invoke(instance, methodArgs);\n"
                "        }\n"
                "        if (result != null) {\n"
                "            System.out.print(result.toString());\n"
                "        }\n"
                "    }\n\n"
                "    private static Object convertArg(String val, Class<?> targetType) {\n"
                "        if (targetType == int.class || targetType == Integer.class) return Integer.parseInt(val);\n"
                "        if (targetType == double.class || targetType == Double.class) return Double.parseDouble(val);\n"
                "        if (targetType == boolean.class || targetType == Boolean.class) return Boolean.parseBoolean(val);\n"
                "        if (targetType == long.class || targetType == Long.class) return Long.parseLong(val);\n"
                "        if (targetType == float.class || targetType == Float.class) return Float.parseFloat(val);\n"
                "        return val;\n"
                "    }\n"
                "}\n"
            )
            runner_path.write_text(runner_code, encoding="utf-8")
            subprocess.run(['javac', 'JavaRunner.java'], capture_output=True, text=True, cwd=self.source_dir, check=True)
            
        class_name = Path(file_name).stem
        cmd = ['java', 'JavaRunner', class_name, function_name] + [str(a) for a in args]
