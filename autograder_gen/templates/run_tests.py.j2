#!/usr/bin/env python3

import os
import re
import sys
import unittest
from pathlib import Path
from gradescope_utils.autograder_utils.json_test_runner import JSONTestRunner


class NaturalOrderTestLoader(unittest.TestLoader):
    def getTestCaseNames(self, testCaseClass):
        names = super().getTestCaseNames(testCaseClass)

        def key_func(name):
            func = getattr(testCaseClass, name, None)
            if func is not None:
                num_str = getattr(func, "__number__", None)
                if num_str is not None:
                    parts = re.findall(r"\d+", str(num_str))
                    if parts:
                        return (0, [int(p) for p in parts])
                code = getattr(func, "__code__", None)
                if code is not None:
                    return (1, [code.co_firstlineno])
            return (2, [name])

        return sorted(names, key=key_func)


def main():
    """Main test runner that combines all question tests."""
{% if config.retrieve_student_id %}
    try:
        from grader_utils import get_student_id
        os.environ["STUDENT_ID"] = get_student_id()
    except Exception as e:
        print(f"[WARNING] Could not retrieve student ID: {e}")
{% endif %}
    loader = NaturalOrderTestLoader()
    suite = loader.discover("tests", pattern="*_test.py")

    def question_sort_key(s):
        desc = str(s)
        m = re.search(r"question_(\d+)", desc)
        return int(m.group(1)) if m else 999

    if hasattr(suite, "_tests"):
        suite._tests = sorted(suite._tests, key=question_sort_key)

    results_path = os.environ.get(
        "GRADESCOPE_RESULTS_PATH", "/autograder/results/results.json"
    )
    with open(results_path, "w") as f:
        runner = JSONTestRunner(visibility="hidden", stream=f)
        runner.run(suite)


if __name__ == "__main__":
    main()

