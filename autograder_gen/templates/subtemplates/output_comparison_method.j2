    @weight({{ item.total_mark }})
    @number({{ question_number }}.{{ loop.index }})
    @visibility('{{ item.visibility }}')
    def test_{{ test_name }}(self):
        """{{ item.name if item.name else (question.name + " - Item " + loop.index|string) }}"""
        print(f"# {{ question_number }}.{{ loop.index }}) {{ item.name if item.name else question.name }}")
        target_file = "{{ item.target_file }}"
        expected_input = """{{ item.expected_input }}"""
        expected_output = """{{ item.expected_output }}"""
        file_path = self.resolve_target(target_file)
        if not file_path.exists():
            self.fail(StudentMessage.WRONG_FILE.format(file_name=target_file))
        
        try:
{% if config.language == 'python' %}
            result = subprocess.run(
                [sys.executable, str(file_path)],
                input=expected_input,
                capture_output=True,
                text=True,
                timeout={{ item.time_limit }},
                cwd=self.source_dir
            )
{% elif config.language == 'java' %}
            class_name = file_path.stem
            target_dir = file_path.parent
            classpath = f"{target_dir}{os.pathsep}{self.source_dir}{os.pathsep}."
            compile_res = subprocess.run(
                ['javac', '-cp', classpath, str(file_path)],
                capture_output=True,
                text=True,
                cwd=self.source_dir
            )
            if compile_res.returncode != 0:
                err = compile_res.stderr or compile_res.stdout
                if err:
                    print(StudentMessage.COMPILING)
                    print(err.strip())
                self.fail(StudentMessage.COMPILER_ERROR)
            result = subprocess.run(
                ['java', '-cp', classpath, class_name],
                input=expected_input,
                capture_output=True,
                text=True,
                timeout={{ item.time_limit }},
                cwd=self.source_dir
            )
{% endif %}
            if result.returncode != 0:
                err = result.stderr.strip() if result.stderr else result.stdout.strip()
                if "SyntaxError" in err or "IndentationError" in err:
                    print(StudentMessage.COMPILING)
                else:
                    print(StudentMessage.RUNNING)
                if err:
                    print(err)
                if "SyntaxError" in err or "IndentationError" in err:
                    self.fail(StudentMessage.COMPILER_ERROR)
                else:
                    self.fail(StudentMessage.RUNTIME_ERROR)
            
            expected_out = normalize_output(expected_output)
            print(StudentMessage.COMPARING_OUTPUT)
            if expected_input:
                print(f"{StudentMessage.INPUT}\n{expected_input}")
            print(f"{StudentMessage.EXPECTED_OUTPUT}\n{expected_out}")
            actual_out = normalize_output(result.stdout)
            print(f"{StudentMessage.ACTUAL_OUTPUT}\n{actual_out}")
            
            if actual_out != expected_out:
                self.fail(StudentMessage.WRONG_ANSWER_FILE.format(file_name=target_file))
            print(f"## Test Passed: {StudentMessage.CORRECT_ANSWER_FILE.format(file_name=target_file)}")
        except AssertionError:
            raise
        except subprocess.TimeoutExpired:
            self.fail(StudentMessage.TIME_LIMIT_EXCEEDED_FILE.format(seconds={{ item.time_limit }}, file_name=target_file))
        except Exception as e:
            print(StudentMessage.RUNNING)
            print(f"Error: {str(e)}")
            self.fail(StudentMessage.RUNTIME_ERROR) 