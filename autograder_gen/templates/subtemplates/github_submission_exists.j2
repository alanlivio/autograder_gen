    @weight({{ item.total_mark }})
    @number({{ question_number }}.{{ loop.index }})
    @visibility('{{ item.visibility }}')
    def test_{{ test_name }}(self):
        """{{ item.name if item.name else (question.name + " - Item " + loop.index|string) }}"""
        print(f"# {{ question_number }}.{{ loop.index }}) {{ item.name if item.name else question.name }}")
        autograder_root = Path(os.environ.get('AUTOGRADER_ROOT', '/autograder'))
        metadata_paths = [
            autograder_root / "submission_metadata.json",
            self.source_dir.parent / "submission_metadata.json",
            self.source_dir / "submission_metadata.json",
            Path("submission_metadata.json"),
        ]
        metadata_path = None
        for p in metadata_paths:
            if p.exists():
                metadata_path = p
                break
        
        if metadata_path is None:
            self.fail(StudentMessage.ERROR_GITHUB_NOT_USED)
        
        try:
            import json
            with metadata_path.open(encoding="utf-8") as f:
                metadata = json.load(f)
            method = metadata.get("submission_method")
            if method and method == "GitHub":
                print(f"## Test Passed: {StudentMessage.CORRECT_GITHUB_SUBMISSION}")
                return
            else:
                self.fail(StudentMessage.ERROR_GITHUB_NOT_USED)
        except AssertionError:
            raise
        except Exception as e:
            self.fail(f"{StudentMessage.RUNTIME_ERROR} Error reading submission metadata: {str(e)}")
